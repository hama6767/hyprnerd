[
  {
    "include": [
      "$HOME/.config/waybar/Modules",
      "$HOME/.config/waybar/ModulesWorkspaces",
      "$HOME/.config/waybar/ModulesCustom",
      "$HOME/.config/waybar/ModulesGroups",
      "$HOME/.config/waybar/UserModules"
    ],
    "name": "topbar",
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "spacing": 2,
    "passthrough": false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,
    "modules-left": [
      "group/app_drawer",
      "custom/capslock",
      "clock",
      "hyprland/window"
    ],
    "modules-center": [
      "custom/monitor",
      "group/desktops"
    ],
    "modules-right": [
      "custom/window-mode",
      "network",
      "pulseaudio",
      "group/mobo_drawer",
      "idle_inhibitor",
      "custom/nightlight",
      "tray",
      "custom/swaync",
      "group/power"
    ],
    "height": 30
  }
]
